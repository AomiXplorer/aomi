# Aomi works in aomi/ inside a project. Keep the artifacts, ignore the noise.
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/
*.swp

# dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# build output
dist/
build/
*.egg-info/
.next/
.cache/
coverage/
*.log

# generated raster previews of the SVG assets (rebuild with scripts/build_assets.py)
/tmp/
